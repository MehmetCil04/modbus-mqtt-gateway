    [ "esp:16", "esp:18", "#aa55ff", [ "v120", "h-260", "v0" ] ],

    [ "esp:17", "ledTx:A",   "yellow", [ "v0" ] ],
    [ "ledTx:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:18", "ledRx:A",   "green",  [ "v0" ] ],
    [ "ledRx:C", "esp:GND.3", "black", [ "v0" ] ]
