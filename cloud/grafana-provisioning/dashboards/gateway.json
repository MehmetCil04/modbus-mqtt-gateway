{
  "uid": "gw-overview",
  "title": "Gateway Telemetri",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gerilim (V)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket:\"telemetry\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"gateway\" and r.tag == \"voltage\" and r._field == \"value\")"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "volt" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Akım (A)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket:\"telemetry\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"gateway\" and r.tag == \"current\" and r._field == \"value\")"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "amp" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Güç (W)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket:\"telemetry\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"gateway\" and r.tag == \"power\" and r._field == \"value\")"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "watt" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sıcaklık (°C)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket:\"telemetry\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"gateway\" and r.tag == \"temperature\" and r._field == \"value\")"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Anlık Güç",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket:\"telemetry\") |> range(start: -2m) |> filter(fn:(r) => r._measurement == \"gateway\" and r.tag == \"power\" and r._field == \"value\") |> last()"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "watt", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 700 }, { "color": "red", "value": 900 } ] } }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Anlık Gerilim",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket:\"telemetry\") |> range(start: -2m) |> filter(fn:(r) => r._measurement == \"gateway\" and r.tag == \"voltage\" and r._field == \"value\") |> last()"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "volt" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Aktif Cihazlar",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket:\"telemetry\") |> range(start: -5m) |> filter(fn:(r) => r._measurement == \"gateway\" and r._field == \"value\") |> keep(columns:[\"device\"]) |> group() |> distinct(column:\"device\") |> count()"
        }
      ]
    }
  ]
}
